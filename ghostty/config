# --- Ghostty Configuration ---

# Window padding
window-padding-x = 2
window-padding-y = 2

# macOS titlebar style
macos-titlebar-style = "hidden"

# --- Font Configuration ---
# Using Monaspace variants
font-family = "Monaspace Argon Var"
font-family-bold = "Monaspace Neon Var"
font-family-bold-italic = "Monaspace Neon Var"
font-family-italic = "Monaspace Radon Var"
font-size = 14.0

# Monaspace font features
font-feature = "zero,kern,calt,clig,liga,ss01,ss02,ss03,ss04,ss05,ss06,ss07,ss08,ss09,ss10,ss11,ss12,ss13,ss14,ss15,ss16,ss17,ss18"

# --- Rendering ---
alpha-blending = "linear-corrected"
background-opacity = 0.8

# --- Catppuccin Mocha ---
background = #1e1e2e
foreground = #cdd6f4
cursor-color = #f5e0dc
cursor-text = #1e1e2e
selection-background = #585b70
selection-foreground = #cdd6f4

palette = 0=#45475a
palette = 1=#f38ba8
palette = 2=#a6e3a1
palette = 3=#f9e2af
palette = 4=#89b4fa
palette = 5=#f5c2e7
palette = 6=#94e2d5
palette = 7=#bac2de
palette = 8=#585b70
palette = 9=#f38ba8
palette = 10=#a6e3a1
palette = 11=#f9e2af
palette = 12=#89b4fa
palette = 13=#f5c2e7
palette = 14=#94e2d5
palette = 15=#a6adc8

# --- Cursor Style ---
cursor-style = "block"
cursor-style-blink = false

# --- Shell & Command ---
shell-integration = "zsh"
shell-integration-features = "no-cursor"

# Compatibility
term = "xterm-256color"

# Keep terminal open after command exits.
wait-after-command = false
quit-after-last-window-closed = true

# --- Scrollback ---
scrollback-limit = 100000
