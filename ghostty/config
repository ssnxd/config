# --- Ghostty Configuration ---
auto-update-channel = tip

# Window padding
window-padding-x = 2
window-padding-y = 2

# macOS titlebar style
macos-titlebar-style = "hidden"

# --- Font Configuration ---
# Monaspace superfamily (Nerd Font patched statics, v1.400).
# Installed family names are "Monaspace <Variant> NF" -- NOT "... Var".
# Swap the four lines below to change variant: Neon (neo-grotesque),
# Argon (humanist), Xenon (slab serif), Krypton (mechanical).
font-family = "Monaspace Neon NF"
font-family-bold = "Monaspace Neon NF"
# Radon is the handwriting cut -- italic comments read as margin notes.
font-family-italic = "Monaspace Radon NF"
font-family-bold-italic = "Monaspace Radon NF"
font-size = 14.0

# Texture healing: rebalances tight/loose pairs (mm, il, ff). This is the
# headline Monaspace feature and it lives entirely in calt.
font-feature = "calt"
font-feature = "liga"

# Monaspace gates its coding ligatures behind stylistic sets -- calt+liga
# alone gives you NONE of them. Comment a line out to drop that group.
# NB: Ghostty does not strip trailing "#" comments from a value, so these
# annotations have to sit on their own lines or the feature is silently
# parsed as part of the string and dropped.
#   ss01 = equals ligatures   == === =/=
#   ss02 = comparisons        != >= <=
#   ss03 = arrows             -> <- -->
#   ss05 = F#-style shapes    |> <|
#   ss09 = double arrows      => <=> ==>
font-feature = "ss01"
font-feature = "ss02"
font-feature = "ss03"
font-feature = "ss05"
font-feature = "ss09"
# Off by default -- uncomment to taste:
#   ss04 = HTML tags  </ />      ss06 = Markdown strings
#   ss07 = centered colon        ss08 = centered period
#   ss10 = other tags
# font-feature = "ss04"
# font-feature = "ss06"
# font-feature = "ss07"
# font-feature = "ss08"
# font-feature = "ss10"

# Zero style. Default is a dotted zero; cv01=2 is the classic slash.
# 1=plain(!) 2=slashed 3=cut 4=open-cut
font-feature = "cv01=2"

# --- Rendering ---
alpha-blending = "linear-corrected"
background-opacity = 1.0

# --- Catppuccin Mocha ---
background = #1e1e2e
foreground = #cdd6f4
cursor-color = #f5e0dc
cursor-text = #1e1e2e
selection-background = #585b70
selection-foreground = #cdd6f4

palette = 0=#45475a
palette = 1=#f38ba8
palette = 2=#a6e3a1
palette = 3=#f9e2af
palette = 4=#89b4fa
palette = 5=#f5c2e7
palette = 6=#94e2d5
palette = 7=#bac2de
palette = 8=#585b70
palette = 9=#f38ba8
palette = 10=#a6e3a1
palette = 11=#f9e2af
palette = 12=#89b4fa
palette = 13=#f5c2e7
palette = 14=#94e2d5
palette = 15=#a6adc8

# --- Cursor Style ---
cursor-style = "block"
cursor-style-blink = false

# --- Shell & Command ---
shell-integration = "zsh"
shell-integration-features = "no-cursor"

# Use Ghostty's own terminfo (tmux 3.3+ understands it)
term = "xterm-ghostty"

# --- Clipboard ---
clipboard-read = allow
clipboard-write = allow
clipboard-paste-protection = false

# --- Keybinds ---
# Newline in Claude Code and other TUIs
keybind = shift+enter=text:\n

# Keep terminal open after command exits.
wait-after-command = false
quit-after-last-window-closed = true

# --- Scrollback (bytes, not lines) ---
# scrollback-limit-bytes = 20000000
