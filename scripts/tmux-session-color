#!/usr/bin/env bash

# Give every tmux session its own accent colour, so a session is recognisable
# without reading. Sets the session option @accent, which tmux.conf uses for
# the status blocks and the active pane border.

set -euo pipefail

MAP_FILE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/tmux/session-colors"
PALETTE=(mauve green peach blue red teal yellow pink)

name_to_hex() {
	case "$1" in
	mauve) printf 'cba6f7' ;;
	green) printf 'a6e3a1' ;;
	peach) printf 'fab387' ;;
	blue) printf '89b4fa' ;;
	red) printf 'f38ba8' ;;
	teal) printf '94e2d5' ;;
	yellow) printf 'f9e2af' ;;
	pink) printf 'f5c2e7' ;;
	\#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) printf '%s' "${1#\#}" ;;
	*) return 1 ;;
	esac
}

mapped_colour() {
	local session_name="$1"

	[[ -f "$MAP_FILE" ]] || return 1
	awk -F= -v name="$session_name" '
		/^[[:space:]]*#/ { next }
		NF >= 2 {
			key = $1; value = $2
			gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
			gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
			if (key == name) { print value; found = 1; exit }
		}
		END { exit found ? 0 : 1 }
	' "$MAP_FILE"
}

hashed_colour() {
	local session_name="$1"
	local hash

	hash="$(printf '%s' "$session_name" | cksum | cut -d' ' -f1)"
	printf '%s' "${PALETTE[$((hash % ${#PALETTE[@]}))]}"
}

colour_session() {
	local session_name="$1"
	local colour hex

	colour="$(mapped_colour "$session_name" || hashed_colour "$session_name")"
	hex="$(name_to_hex "$colour" || name_to_hex "$(hashed_colour "$session_name")")"

	tmux set-option -t "=$session_name:" @accent "#$hex"
}

tmux list-sessions -F '#{session_name}' | while IFS= read -r session_name; do
	colour_session "$session_name"
done
